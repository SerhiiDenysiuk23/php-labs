{% extends 'base.html.twig' %}
{% block title %}Book Issues{% endblock %}
{% block body %}
    <h1>Book Issues</h1>
    <form method="GET" class="mb-3">
        <label for="itemsPerPage">Show per page:</label>
        <select name="itemsPerPage" id="itemsPerPage"
                onchange="this.form.submit()"
                class="form-select w-auto d-inline-block ms-2">
            {% for n in allowed %}
                <option value="{{ n }}" {{ itemsPerPage == n ? 'selected' : '' }}>
                    {{ n }}
                </option>
            {% endfor %}
        </select>
    </form>
    <a href="{{ path('issue_new') }}">Create new issue</a>
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
        <tr>
            <th>ID</th>
            <th>Book</th>
            <th>Reader</th>
            <th>Issued At</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for issue in pagination %}
            <tr>
                <td>{{ issue.id }}</td>
                <td>{{ issue.book.title }}</td>
                <td>{{ issue.reader.name }}</td>
                <td>{{ issue.issuedAt|date('Y-m-d H:i') }}</td>
                <td>
                    <a href="{{ path('issue_show', {id: issue.id}) }}">show</a>
                    <a href="{{ path('issue_edit', {id: issue.id}) }}">edit</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}