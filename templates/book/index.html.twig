{% extends 'base.html.twig' %}
{% block title %}Books{% endblock %}
{% block body %}
    <h1>Books</h1>
    <form method="GET" class="mb-3">
        <label for="itemsPerPage">Show per page:</label>
        <select name="itemsPerPage" id="itemsPerPage"
                onchange="this.form.submit()"
                class="form-select w-auto d-inline-block ms-2">
            {% for n in allowed %}
                <option value="{{ n }}" {{ itemsPerPage == n ? 'selected' : '' }}>
                    {{ n }}
                </option>
            {% endfor %}
        </select>
    </form>

    <a href="{{ path('book_new') }}">Create new book</a>
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>ISBN</th>
            <th>Author</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for book in pagination %}
            <tr>
                <td>{{ book.id }}</td>
                <td>{{ book.title }}</td>
                <td>{{ book.isbn }}</td>
                <td>{{ book.author.name }}</td>
                <td>
                    <a href="{{ path('book_show', {id: book.id}) }}">show</a>
                    <a href="{{ path('book_edit', {id: book.id}) }}">edit</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}