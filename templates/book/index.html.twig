{% extends 'base.html.twig' %}
{% block title %}Books{% endblock %}
{% block body %}
    <h1>Books</h1>
    <a href="{{ path('book_new') }}">Create new book</a>
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>ISBN</th>
            <th>Author</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.id }}</td>
                <td>{{ book.title }}</td>
                <td>{{ book.isbn }}</td>
                <td>{{ book.author.name }}</td>
                <td>
                    <a href="{{ path('book_show', {id: book.id}) }}">show</a>
                    <a href="{{ path('book_edit', {id: book.id}) }}">edit</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}