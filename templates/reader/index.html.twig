{% extends 'base.html.twig' %}
{% block title %}Readers{% endblock %}
{% block body %}
    <h1>Readers</h1>
    <form method="GET" class="mb-3">
        <label for="itemsPerPage">Show per page:</label>
        <select name="itemsPerPage" id="itemsPerPage"
                onchange="this.form.submit()"
                class="form-select w-auto d-inline-block ms-2">
            {% for n in allowed %}
                <option value="{{ n }}" {{ itemsPerPage == n ? 'selected' : '' }}>
                    {{ n }}
                </option>
            {% endfor %}
        </select>
    </form>
    <a href="{{ path('reader_new') }}">Create new reader</a>
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for reader in pagination %}
            <tr>
                <td>{{ reader.id }}</td>
                <td>{{ reader.name }}</td>
                <td>{{ reader.email }}</td>
                <td>
                    <a href="{{ path('reader_show', {id: reader.id}) }}">show</a>
                    <a href="{{ path('reader_edit', {id: reader.id}) }}">edit</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}